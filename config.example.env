# ========= 赛博要饭 配置示例 =========
# 复制为 config.env 后填写。config.env 已被 .gitignore 排除，勿提交。同名环境变量优先于本文件。

# 监听地址与对外基础 URL（回调地址、子站地址、登录链接都用它拼接）
LISTEN=127.0.0.1:8124
BASE_URL=https://beggar.example.com

# 主站站长口令：在 BASE_URL/login 里「路径留空 + 此口令」登录后台。生成方法: ./beggar -gen-key
ADMIN_PASSWORD=
# 页脚作者链接（可留空不显示）
AUTHOR_GITHUB=https://github.com/qianyubtc
AUTHOR_X=https://x.com/qianyuwing
# 说明：ADMIN_PASSWORD 只在首次建站或这里的值改变时写入；主站在后台改过口令后重启不会被冲掉

# 站点标题
SITE_TITLE=赛博要饭

# ---- 主站资料（首次启动写入数据库，之后在后台改；改这里不会覆盖库里的）----
MAIN_NAME=芊羽Wing
MAIN_SLOGAN=行行好，赏口饭吃 🙏
MAIN_STORY=
MAIN_AVATAR=🥣
# 可选：绑定 X 主页（@名字 或 https://x.com/名字）
MAIN_X=

# ---- 收款（每次启动按这里覆盖主站配置）----
# 方式一（推荐）：BinancePayTool 网关（须为支持多账号的版本），主站到账自动确认，
# 子站站长也能在后台绑定自己的币安只读 Key（本站把 Key 注册到网关成为独立收款账号）。
# BPG_KEY = 网关的 API_AUTH_KEY。网关与本站同机时可直接填网关的内网监听地址，如 http://127.0.0.1:8123
BPG_URL=
BPG_KEY=
# 方式二：不接网关，主站走直接转账（施主自报、站长在后台确认）。填收款二维码解码链接和/或 Pay ID。
MAIN_RECEIVE_LINK=
MAIN_PAY_ID=

# ---- 施舍 ----
CURRENCY=USDT
# 金额档位（页面上再加一个「自定义」）与上下限
PRESET_AMOUNTS=0.1,1
MIN_AMOUNT=0.1
MAX_AMOUNT=10000
# 网关订单有效期（秒），120–86400
ORDER_TTL=900

# ---- 子站 ----
# 是否开放开站（用 X 发推验证，BASE_URL/路径）
SUBSITES_ENABLED=true
# 新子站是否默认「未收录」（不进榜、noindex），由主站站长在后台收录。建议开，防广告站蹭曝光
SUBSITE_REVIEW=true
# 钢镚（免费点赞币）：每人每站每天几个；每 IP 每站每天上限
COINS_PER_DAY=1
COINS_IP_CAP=20
# 经验：EXP = 碗里的钱(U) × MONEY_EXP + 钢镚 × COIN_EXP。默认 0.1 U = 1 EXP、1 钢镚 = 1 EXP。
# 袋位门槛（EXP）：一袋 1 / 二袋 10 / 三袋 50 / 四袋 200 / 五袋 500 / 六袋 1000 / 七袋 3000 / 八袋 10000 / 九袋 50000
COIN_EXP=1
MONEY_EXP=10

# ---- X（推特）----
# 发推验证与施主头像用到的公开接口，一般不用改；测试时可指向 mock
X_TWEET_API=https://cdn.syndication.twimg.com
X_AVATAR_API=https://unavatar.io
# 头像缓存目录（需可写）
AVATAR_DIR=./avatars

# ---- 反向代理 ----
# 放在反向代理之后时开启：只在请求来自内网/回环地址时才信下面这个头，限流按真实访客 IP
TRUST_PROXY=true
# 直接 Caddy/Nginx 反代：X-Forwarded-For（取最后一跳，反代自己追加的那个）；
# 前面还有 Cloudflare：填 CF-Connecting-IP（并建议防火墙只放行 Cloudflare 回源 IP，防止绕过 CF 直连伪造）
TRUST_PROXY_HEADER=X-Forwarded-For

# ---- 存储 ----
DB_PATH=./beggar.db
